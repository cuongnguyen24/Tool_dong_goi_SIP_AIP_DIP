<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AXE.PackagingTool.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:AXE.PackagingTool.ViewModels" Title="AXE SoHoa — Công cụ đóng gói lưu trữ số (TT05/2025)" Width="960" Height="700" MinWidth="760" MinHeight="560" Background="{StaticResource BgDark}" FontFamily="Segoe UI" xmlns:packagingtool="clr-namespace:AXE.PackagingTool">
  <FrameworkElement.DataContext>
    <vm:MainViewModel />
  </FrameworkElement.DataContext>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="60" />
      <RowDefinition Height="*" />
      <RowDefinition Height="36" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
      <Grid Margin="20,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="📦" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="AXE SoHoa — Công cụ đóng gói lưu trữ số" FontSize="16" FontFamily="Segoe UI Semibold" />
            <TextBlock Text="Chuẩn E-ARK CSIP v2.0.4  •  Thông tư 05/2025/TT-BNV" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
        <TextBlock Text="v1.0.0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="11" />
      </Grid>
    </Border>
    <Grid Row="1" Margin="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" MinWidth="300" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" Padding="20">
        <StackPanel>
          <TextBlock Text="CỘT GỘP HỒ SƠ" FontSize="11" Foreground="{StaticResource TextSecondary}" FontFamily="Segoe UI Semibold" Margin="0,0,0,8" />
          <TextBox ToolTip="Mã cột trong file Excel để gộp chung 1 hồ sơ (mặc định: FileCodehs)" Margin="0,0,0,16" Text="{Binding GroupingColumn, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="LOẠI GÓI" FontSize="11" Foreground="{StaticResource TextSecondary}" FontFamily="Segoe UI Semibold" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton Content="SIP" Margin="0,0,16,0" Foreground="{StaticResource TextPrimary}" IsChecked="{Binding IsSipSelected}" />
            <RadioButton Content="AIP" Margin="0,0,16,0" Foreground="{StaticResource TextPrimary}" IsChecked="{Binding IsAipSelected}" />
            <RadioButton Content="DIP" Foreground="{StaticResource TextPrimary}" IsChecked="{Binding IsDipSelected}" />
          </StackPanel>
          <StackPanel Margin="0,10,0,16">
            <CheckBox Content="Đồng bộ loại tài liệu Bìa (BIA.pdf)" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" IsChecked="{Binding SyncCover}" />
            <CheckBox Content="Đồng bộ loại tài liệu Mục lục (MUCLUC.pdf)" Foreground="{StaticResource TextPrimary}" IsChecked="{Binding SyncTableOfContents}" />
          </StackPanel>
          <Separator Background="{StaticResource Border}" Margin="0,0,0,20" />
          <TextBlock Text="FILE EXCEL ĐẦU VÀO" FontSize="11" Foreground="{StaticResource TextSecondary}" FontFamily="Segoe UI Semibold" Margin="0,0,0,8" />
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding ExcelFilePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding ExcelFilePath}" />
            <Button Grid.Column="1" Content="..." Style="{StaticResource SecondaryButton}" Width="36" Margin="6,0,0,0" Command="{Binding BrowseExcelCommand}" />
          </Grid>
          <TextBlock Text="THƯ MỤC GỐC (chứa file tài liệu)" FontSize="11" Foreground="{StaticResource TextSecondary}" FontFamily="Segoe UI Semibold" Margin="0,0,0,8" />
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding BaseFolderPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding BaseFolderPath}" />
            <Button Grid.Column="1" Content="..." Style="{StaticResource SecondaryButton}" Width="36" Margin="6,0,0,0" Command="{Binding BrowseBaseFolderCommand}" />
          </Grid>
          <TextBlock Text="THƯ MỤC XUẤT FILE ZIP" FontSize="11" Foreground="{StaticResource TextSecondary}" FontFamily="Segoe UI Semibold" Margin="0,0,0,8" />
          <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding OutputFolderPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding OutputFolderPath}" />
            <Button Grid.Column="1" Content="..." Style="{StaticResource SecondaryButton}" Width="36" Margin="6,0,0,0" Command="{Binding BrowseOutputCommand}" />
          </Grid>
          <Separator Background="{StaticResource Border}" Margin="0,0,0,20" />
          <Button Content="🔍  Xác thực trước" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Height="38" Margin="0,0,0,10" Command="{Binding ValidateCommand}" />
          <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Height="42" FontSize="15" Margin="0,0,0,10" Content="{Binding PackageButtonText}" Command="{Binding PackageCommand}" />
          <Button Content="⛔  Hủy" Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch" Height="36" Margin="0,0,0,16" Command="{Binding CancelCommand}" />
          <Button Content="📁  Mở thư mục xuất" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Command="{Binding OpenOutputCommand}" />
        </StackPanel>
      </Border>
      <Grid Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,12">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="THỐNG KÊ &amp; LOG ĐẦU RA" FontSize="12" Foreground="{StaticResource TextSecondary}" FontFamily="Segoe UI Semibold" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Tổng hồ sơ:" Foreground="{StaticResource TextSecondary}" Margin="0,0,4,0" />
                <TextBlock FontWeight="Bold" Foreground="#FFFFFFFF" Width="30" Text="{Binding TotalProfiles}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Đã đóng gói:" Foreground="{StaticResource TextSecondary}" Margin="0,0,4,0" />
                <TextBlock FontWeight="Bold" Foreground="#3498DB" Width="30" Text="{Binding PackagedProfiles}" />
              </StackPanel>
              <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Dòng (TL) hợp lệ:" Foreground="{StaticResource TextSecondary}" Margin="0,0,4,0" />
                <TextBlock FontWeight="Bold" Foreground="#4CAF50" Width="30" Text="{Binding SuccessRows}" />
              </StackPanel>
              <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Dòng (TL) lỗi:" Foreground="{StaticResource TextSecondary}" Margin="0,0,4,0" />
                <TextBlock FontWeight="Bold" Foreground="#F44336" Width="30" Text="{Binding ErrorRows}" />
              </StackPanel>
            </Grid>
            <Grid Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Height="4" Foreground="#3498DB" BorderThickness="0" Background="{StaticResource BgInput}" VerticalAlignment="Center" Margin="0,0,10,0" Value="{Binding Progress}" />
              <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Text="{Binding Progress, StringFormat={}{0}%}" />
            </Grid>
          </StackPanel>
        </Border>
        <Grid Row="1" Margin="16,8,16,8" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="📥 Tải file mẫu" Style="{StaticResource SecondaryButton}" Foreground="{StaticResource Accent}" Margin="0,0,10,0" Command="{Binding DownloadTemplateCommand}" />
            <Button Content="❌ Xóa log" Style="{StaticResource SecondaryButton}" Foreground="#E74C3C" Margin="0,0,10,0" Command="{Binding ClearLogCommand}" />
            <Button Content="📊 Xuất thống kê (Excel)" Style="{StaticResource SecondaryButton}" Foreground="{StaticResource Success}" Margin="0,0,10,0" Command="{Binding ExportSummaryCommand}" />
            <Button Content="💾 Xuất Excel (Log lỗi)" Style="{StaticResource SecondaryButton}" Foreground="{StaticResource Accent}" Margin="0,0,10,0" Command="{Binding ExportExcelCommand}" />
            <Button Content="💾 Xuất Excel (Thành công)" Style="{StaticResource SecondaryButton}" Foreground="{StaticResource Success}" Command="{Binding ExportSuccessExcelCommand}" />
          </StackPanel>
        </Grid>
        <DataGrid Name="LogGrid" Grid.Row="1" Margin="16,40,16,16" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="#00FFFFFF" Foreground="{StaticResource TextPrimary}" BorderThickness="0" RowBackground="#00FFFFFF" AlternatingRowBackground="#08FFFFFF" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Border}" ItemsSource="{Binding ErrorLogView}">
          <DataGrid.ColumnHeaderStyle>
            <Style TargetType="{x:Type DataGridColumnHeader}">
              <Setter Property="Background" Value="#F5F5F5" />
              <Setter Property="Foreground" Value="#FF000000" />
              <Setter Property="TextElement.Foreground" Value="#FF000000" />
              <Setter Property="ContentTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <TextBlock Foreground="#FF000000" FontWeight="Bold" Text="{Binding}" />
                  </DataTemplate>
                </Setter.Value>
              </Setter>
              <Setter Property="FontWeight" Value="Bold" />
              <Setter Property="Padding" Value="10,8" />
              <Setter Property="BorderBrush" Value="#DDDDDD" />
              <Setter Property="BorderThickness" Value="0,0,1,1" />
            </Style>
          </DataGrid.ColumnHeaderStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Dòng số" Width="80" Binding="{Binding ExcelRowIndex}" />
            <DataGridTextColumn Header="Mã Hồ Sơ" Width="140" Binding="{Binding ProfileCode}" />
            <DataGridTextColumn Header="Mã Tài Liệu" Width="120" Binding="{Binding DocumentCode}" />
            <DataGridTemplateColumn Header="Trạng thái" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0" Background="{Binding Foreground}">
                    <TextBlock Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="11" Text="{Binding StatusName}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Chi tiết lỗi" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="5" Text="{Binding Message}" Foreground="{Binding Foreground}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
      <Grid Margin="16,0">
        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondary}" Text="{Binding StatusText}" />
      </Grid>
    </Border>
  </Grid>
</Window>