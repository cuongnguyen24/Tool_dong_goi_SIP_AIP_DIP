<Window x:Class="AXE.PackagingTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AXE.PackagingTool.ViewModels"
        Title="AXE SoHoa — Công cụ đóng gói lưu trữ số (TT05/2025)"
        Width="960" Height="700"
        MinWidth="760" MinHeight="560"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="60"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Status bar -->
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📦" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AXE SoHoa — Công cụ đóng gói lưu trữ số"
                                   FontSize="16" FontFamily="Segoe UI Semibold"/>
                        <TextBlock Text="Chuẩn E-ARK CSIP v2.0.4  •  Thông tư 05/2025/TT-BNV"
                                   FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Version badge -->
                <TextBlock Text="v1.0.0" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" FontSize="11"/>
            </Grid>
        </Border>

        <!-- ══════════════════ MAIN CONTENT ══════════════════ -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT PANEL (configuration) ─────────────────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>

                        <!-- SECTION: Loại gói -->
                        <TextBlock Text="LOẠI GÓI" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="Segoe UI Semibold"
                                   Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding PackageTypes}"
                                  SelectedItem="{Binding SelectedPackageType}"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNot}}"
                                  Margin="0,0,0,4"/>
                        <Button Content="📥  Tải file template Excel"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding DownloadTemplateCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,6,0,20"/>

                        <Separator Background="{StaticResource Border}" Margin="0,0,0,20"/>

                        <!-- SECTION: File Excel -->
                        <TextBlock Text="FILE EXCEL ĐẦU VÀO" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="Segoe UI Semibold"
                                   Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding ExcelFilePath, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True"
                                     ToolTip="{Binding ExcelFilePath}"/>
                            <Button Grid.Column="1"
                                    Content="..."
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseExcelCommand}"
                                    Width="36" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- SECTION: Thư mục gốc -->
                        <TextBlock Text="THƯ MỤC GỐC (chứa file tài liệu)" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="Segoe UI Semibold"
                                   Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding BaseFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True"
                                     ToolTip="{Binding BaseFolderPath}"/>
                            <Button Grid.Column="1"
                                    Content="..."
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseBaseFolderCommand}"
                                    Width="36" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- SECTION: Thư mục xuất -->
                        <TextBlock Text="THƯ MỤC XUẤT FILE ZIP" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="Segoe UI Semibold"
                                   Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding OutputFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True"
                                     ToolTip="{Binding OutputFolderPath}"/>
                            <Button Grid.Column="1"
                                    Content="..."
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseOutputCommand}"
                                    Width="36" Margin="6,0,0,0"/>
                        </Grid>

                        <Separator Background="{StaticResource Border}" Margin="0,0,0,20"/>

                        <!-- ACTION BUTTONS -->
                        <Button Content="🔍  Xác thực trước"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ValidateCommand}"
                                HorizontalAlignment="Stretch"
                                Height="38"
                                Margin="0,0,0,10"/>

                        <Button Content="📦  Đóng gói"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding PackageCommand}"
                                HorizontalAlignment="Stretch"
                                Height="42"
                                FontSize="15"
                                Margin="0,0,0,10"/>

                        <Button Content="⛔  Hủy"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding CancelCommand}"
                                HorizontalAlignment="Stretch"
                                Height="36"
                                Margin="0,0,0,16"/>

                        <Button Content="📁  Mở thư mục xuất"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenOutputCommand}"
                                HorizontalAlignment="Left"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── RIGHT PANEL (log output) ───────────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Log toolbar -->
                <Border Grid.Row="0"
                        Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="0,0,0,1"
                        Padding="16,8">
                    <Grid>
                        <TextBlock Text="LOG ĐẦU RA" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="Segoe UI Semibold"
                                   VerticalAlignment="Center"/>
                        <Button Content="Xóa log"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ClearLogCommand}"
                                HorizontalAlignment="Right"
                                FontSize="11" Padding="10,4"/>
                    </Grid>
                </Border>

                <!-- Log list -->
                <ListBox Grid.Row="1"
                         x:Name="LogList"
                         ItemsSource="{Binding LogEntries}"
                         Background="{StaticResource BgDark}"
                         BorderThickness="0"
                         Padding="12,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding"     Value="0,2"/>
                            <Setter Property="Background"  Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgInput}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Timestamp}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           FontFamily="Consolas"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Message}"
                                           Foreground="{Binding Foreground}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- ══════════════════ STATUS BAR ══════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"/>

                <ProgressBar Grid.Column="1"
                             Value="{Binding Progress}"
                             Minimum="0" Maximum="100"
                             Visibility="{Binding IsBusy,
                                Converter={StaticResource BoolToVis}}"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding Progress, StringFormat={}{0}%}"
                           Visibility="{Binding IsBusy,
                                Converter={StaticResource BoolToVis}}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
