<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="VeraPdfPath" value="" />
    <add key="PdfToTextPath" value="" />
    <add key="PdfImagesPath" value="" />

    <!-- SIP hồ sơ:
         fileCode=mã hồ sơ;
         title=tiêu đề hồ sơ;
         maintenance=thời hạn bảo quản;
         mode=mức độ tiếp cận;
         language=ngôn ngữ;
         startDate=thời gian bắt đầu;
         endDate=thời gian kết thúc;
         totalDoc=tổng số tài liệu trong hồ sơ;
         inforSign=ký hiệu thông tin;
         keyword=từ khóa;
         numberOfPaper=số lượng tờ;
         numberOfPage=số lượng trang;
         format=tình trạng vật lý;
         confidenceLevel=mức độ tin cậy;
         paperFileCode=mã hồ sơ gốc giấy;
         riskRecovery=chế độ lập tài liệu lưu trữ dự phòng;
         riskRecoveryStatus=tình trạng lập tài liệu lưu trữ dự phòng;
         description=ghi chú.
         Bên phải dấu ':' trong cấu hình là tên cột nguồn trong bảng tính. -->
    <add key="SIP_ProfileFields" value="
      fileCode:FileCodehs,
      title:Titlehs,
      maintenance:IDExpiryDatehs,
      mode:UsingModehs,
      language:Languagehs,
      startDate:StartDateStrhs,
      endDate:EndDateStrhs,
      totalDoc:TotalDochs,
      inforSign:InforSignhs,
      keyword:Keywordhs,
      numberOfPaper:Maintenancehs,
      numberOfPage:PageNumberhs,
      format:Formaths,
      confidenceLevel:ConfidenceLevelhs,
      paperFileCode:PaperFileCodehs,
      riskRecovery:RiskRecoveryhs,
      riskRecoveryStatus:RiskRecoveryStatushs,
      description:Descriptionhs" />

    <!-- SIP văn bản:
         docId=mã định danh tài liệu;
         docCode=mã lưu trữ tài liệu;
         maintenance=thời hạn bảo quản;
         typeName=tên loại tài liệu;
         codeNumber=số của tài liệu;
         codeNotation=ký hiệu của tài liệu;
         issuedDate=ngày tháng năm ban hành;
         organName=tên cơ quan, tổ chức, cá nhân ban hành;
         subject=trích yếu nội dung;
         language=ngôn ngữ;
         numberOfPage=số lượng trang;
         inforSign=ký hiệu thông tin;
         keyword=từ khóa;
         mode=mức độ tiếp cận;
         confidenceLevel=mức độ tin cậy;
         autograph=bút tích;
         format=tình trạng vật lý;
         process=quy trình xử lý;
         riskRecovery=chế độ lập tài liệu lưu trữ dự phòng;
         riskRecoveryStatus=tình trạng lập tài liệu lưu trữ dự phòng;
         description=ghi chú. -->
    <add key="SIP_DocumentFields" value="
      docId:DocCode,
      docCode:DocCode,
      maintenance:Maintenance,
      typeName:TypeName,
      codeNumber:CodeNumber,
      codeNotation:CodeNotation,
      issuedDate:IssuedDate,
      organName:OrganName,
      subject:Subject,
      language:Language,
      numberOfPage:NumberOfPage,
      inforSign:InforSign,
      keyword:Keyword,
      mode:Mode,
      confidenceLevel:ConfidenceLevel,
      autograph:Autograph,
      format:Format,
      process:Process,
      riskRecovery:RiskRecovery,
      riskRecoveryStatus:RiskRecoveryStatus,
      description:Description" />

    <!-- SIP ảnh:
         docCode=mã lưu trữ tài liệu;
         maintenance=thời hạn bảo quản;
         typePic=phân loại (âm bản gốc/dương bản);
         archivesNumber=số lưu trữ;
         inforSign=ký hiệu thông tin;
         eventName=tên sự kiện;
         imageTitle=tiêu đề ảnh;
         photographer=tác giả;
         photoPlace=địa điểm chụp;
         photoTime=thời gian chụp;
         colour=màu sắc;
         filmSize=cỡ phim, ảnh;
         docAttached=tài liệu đi kèm;
         mode=mức độ tiếp cận;
         format=tình trạng vật lý;
         riskRecovery=chế độ lập tài liệu lưu trữ dự phòng;
         riskRecoveryStatus=tình trạng lập dự phòng;
         description=ghi chú. -->
    <add key="SIP_PictureFields" value="
      docCode:DocCode,
      maintenance:Maintenance,
      typePic:TypePic,
      archivesNumber:ArchivesNumber,
      inforSign:InforSign,
      eventName:EventName,
      imageTitle:ImageTitle,
      photographer:Photographer,
      photoPlace:PhotoPlace,
      photoTime:PhotoTime,
      colour:Colour,
      filmSize:FilmSize,
      docAttached:DocAttached,
      mode:Mode,
      format:Format,
      riskRecovery:RiskRecovery,
      riskRecoveryStatus:RiskRecoveryStatus,
      description:Description" />

    <!-- SIP ghi âm/ghi hình:
         docCode=mã lưu trữ tài liệu;
         maintenance=thời hạn bảo quản;
         typeMedia=phân loại (âm thanh/video);
         archivesNumber=số lưu trữ;
         inforSign=ký hiệu thông tin;
         eventName=tên sự kiện;
         movieTitle=tiêu đề âm thanh, video;
         recorder=tác giả;
         recordPlace=địa điểm;
         recordDate=thời gian;
         language=ngôn ngữ;
         playTime=thời lượng;
         docAttached=tài liệu đi kèm;
         mode=mức độ tiếp cận;
         quality=chất lượng âm thanh, video;
         format=tình trạng vật lý;
         riskRecovery=chế độ lập tài liệu lưu trữ dự phòng;
         riskRecoveryStatus=tình trạng lập dự phòng;
         description=ghi chú. -->
    <add key="SIP_MediaFields" value="
      docCode:DocCode,
      maintenance:Maintenance,
      typeMedia:TypeMedia,
      archivesNumber:ArchivesNumber,
      inforSign:InforSign,
      eventName:EventName,
      movieTitle:MovieTitle,
      recorder:Recorder,
      recordPlace:RecordPlace,
      recordDate:RecordDate,
      language:Language,
      playTime:PlayTime,
      docAttached:DocAttached,
      mode:Mode,
      quality:Quality,
      format:Format,
      riskRecovery:RiskRecovery,
      riskRecoveryStatus:RiskRecoveryStatus,
      description:Description" />

    <!-- AIP hồ sơ: các trường có cùng nghĩa với SIP hồ sơ;
         arcFileCode=mã lưu trữ hồ sơ. Xem chú thích SIP hồ sơ ở trên. -->
    <add key="AIP_ProfileFields" value="
      arcFileCode:FileCodehs,
      title:Titlehs,
      maintenance:IDExpiryDatehs,
      mode:UsingModehs,
      language:Languagehs,
      startDate:StartDateStrhs,
      endDate:EndDateStrhs,
      totalDoc:TotalDochs,
      inforSign:InforSignhs,
      keyword:Keywordhs,
      numberOfPaper:Maintenancehs,
      numberOfPage:PageNumberhs,
      format:Formaths,
      confidenceLevel:ConfidenceLevelhs,
      paperFileCode:PaperFileCodehs,
      riskRecovery:RiskRecoveryhs,
      riskRecoveryStatus:RiskRecoveryStatushs,
      description:Descriptionhs" />

    <!-- AIP văn bản: các trường có cùng nghĩa với SIP văn bản;
         arcDocCode=mã lưu trữ tài liệu. Xem chú thích SIP văn bản ở trên. -->
    <add key="AIP_DocumentFields" value="
      docId:DocCode,
      arcDocCode:DocCode,
      maintenance:Maintenance,
      typeName:TypeName,
      codeNumber:CodeNumber,
      codeNotation:CodeNotation,
      issuedDate:IssuedDate,
      organName:OrganName,
      subject:Subject,
      language:Language,
      numberOfPage:NumberOfPage,
      inforSign:InforSign,
      keyword:Keyword,
      mode:Mode,
      confidenceLevel:ConfidenceLevel,
      autograph:Autograph,
      format:Format,
      process:Process,
      riskRecovery:RiskRecovery,
      riskRecoveryStatus:RiskRecoveryStatus,
      description:Description" />

    <!-- AIP ảnh: các trường có cùng nghĩa với SIP ảnh;
         arcDocCode=mã lưu trữ tài liệu. Xem chú thích SIP ảnh ở trên. -->
    <add key="AIP_PictureFields" value="
      arcDocCode:DocCode,
      maintenance:Maintenance,
      typePic:TypePic,
      archivesNumber:ArchivesNumber,
      inforSign:InforSign,
      eventName:EventName,
      imageTitle:ImageTitle,
      photographer:Photographer,
      photoPlace:PhotoPlace,
      photoTime:PhotoTime,
      colour:Colour,
      filmSize:FilmSize,
      docAttached:DocAttached,
      mode:Mode,
      format:Format,
      riskRecovery:RiskRecovery,
      riskRecoveryStatus:RiskRecoveryStatus,
      description:Description" />

    <!-- AIP ghi âm/ghi hình: các trường có cùng nghĩa với SIP ghi âm/ghi hình;
         arcDocCode=mã lưu trữ tài liệu. Xem chú thích SIP ghi âm/ghi hình ở trên. -->
    <add key="AIP_MediaFields" value="
      arcDocCode:DocCode,
      maintenance:Maintenance,
      typeMedia:TypeMedia,
      archivesNumber:ArchivesNumber,
      inforSign:InforSign,
      eventName:EventName,
      movieTitle:MovieTitle,
      recorder:Recorder,
      recordPlace:RecordPlace,
      recordDate:RecordDate,
      language:Language,
      playTime:PlayTime,
      docAttached:DocAttached,
      mode:Mode,
      quality:Quality,
      format:Format,
      riskRecovery:RiskRecovery,
      riskRecoveryStatus:RiskRecoveryStatus,
      description:Description" />

    <!-- DIP phần yêu cầu sử dụng:
         requestID=mã yêu cầu;
         requestDate=ngày yêu cầu;
         purpose=mục đích sử dụng;
         purposeContent=nội dung mục đích;
         feeObjectType=đối tượng thu phí;
         researchTopic=đề tài nghiên cứu;
         description=ghi chú.
         Tên sau ':' là cột nguồn; đây là dữ liệu yêu cầu khai thác. -->
    <add key="DIP_ProfileFields" value="
      requestID:RequestID,
      requestDate:RequestDate,
      purpose:Purpose,
      purposeContent:PurposeContent,
      feeObjectType:FeeObjectType,
      researchTopic:ResearchTopic,
      description:Description" />

    <!-- DIP văn bản: các trường có cùng nghĩa với SIP văn bản;
         arcDocCode=mã lưu trữ tài liệu. Xem chú thích SIP văn bản ở trên. -->
    <add key="DIP_DocumentFields" value="
      docId:DocCode,
      arcDocCode:DocCode,
      maintenance:Maintenance,
      typeName:TypeName,
      codeNumber:CodeNumber,
      codeNotation:CodeNotation,
      issuedDate:IssuedDate,
      organName:OrganName,
      subject:Subject,
      language:Language,
      numberOfPage:NumberOfPage,
      inforSign:InforSign,
      keyword:Keyword,
      mode:Mode,
      confidenceLevel:ConfidenceLevel,
      autograph:Autograph,
      format:Format,
      process:Process,
      riskRecovery:RiskRecovery,
      riskRecoveryStatus:RiskRecoveryStatus,
      description:Description" />

    <!-- DIP ảnh: các trường có cùng nghĩa với SIP ảnh;
         arcDocCode=mã lưu trữ tài liệu. Xem chú thích SIP ảnh ở trên. -->
    <add key="DIP_PictureFields" value="
      arcDocCode:DocCode,
      maintenance:Maintenance,
      typePic:TypePic,
      archivesNumber:ArchivesNumber,
      inforSign:InforSign,
      eventName:EventName,
      imageTitle:ImageTitle,
      photographer:Photographer,
      photoPlace:PhotoPlace,
      photoTime:PhotoTime,
      colour:Colour,
      filmSize:FilmSize,
      docAttached:DocAttached,
      mode:Mode,
      format:Format,
      riskRecovery:RiskRecovery,
      riskRecoveryStatus:RiskRecoveryStatus,
      description:Description" />

    <!-- DIP ghi âm/ghi hình: các trường có cùng nghĩa với SIP ghi âm/ghi hình;
         arcDocCode=mã lưu trữ tài liệu. Xem chú thích SIP ghi âm/ghi hình ở trên. -->
    <add key="DIP_MediaFields" value="
      arcDocCode:DocCode,
      maintenance:Maintenance,
      typeMedia:TypeMedia,
      archivesNumber:ArchivesNumber,
      inforSign:InforSign,
      eventName:EventName,
      movieTitle:MovieTitle,
      recorder:Recorder,
      recordPlace:RecordPlace,
      recordDate:RecordDate,
      language:Language,
      playTime:PlayTime,
      docAttached:DocAttached,
      mode:Mode,
      quality:Quality,
      format:Format,
      riskRecovery:RiskRecovery,
      riskRecoveryStatus:RiskRecoveryStatus,
      description:Description" />
  </appSettings>
</configuration>
