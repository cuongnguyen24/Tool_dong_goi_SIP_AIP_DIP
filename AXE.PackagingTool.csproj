<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AXE.PackagingTool</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>True</UseWindowsForms>
    <GenerateTargetFrameworkAttribute>False</GenerateTargetFrameworkAttribute>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace />
    <UseBundledDependencies Condition="'$(UseBundledDependencies)' == ''">true</UseBundledDependencies>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="AXE.PackagingTool.Schemas.METS.xsd" />
    <None Remove="AXE.PackagingTool.Schemas.EAD.xsd" />
    <None Remove="AXE.PackagingTool.Schemas.EAD_doc.xsd" />
    <None Remove="AXE.PackagingTool.Schemas.EAD_pic.xsd" />
    <None Remove="AXE.PackagingTool.Schemas.EAD_media.xsd" />
    <EmbeddedResource Include="AXE.PackagingTool.Schemas.METS.xsd" LogicalName="AXE.PackagingTool.Schemas.METS.xsd" />
    <EmbeddedResource Include="AXE.PackagingTool.Schemas.EAD.xsd" LogicalName="AXE.PackagingTool.Schemas.EAD.xsd" />
    <EmbeddedResource Include="AXE.PackagingTool.Schemas.EAD_doc.xsd" LogicalName="AXE.PackagingTool.Schemas.EAD_doc.xsd" />
    <EmbeddedResource Include="AXE.PackagingTool.Schemas.EAD_pic.xsd" LogicalName="AXE.PackagingTool.Schemas.EAD_pic.xsd" />
    <EmbeddedResource Include="AXE.PackagingTool.Schemas.EAD_media.xsd" LogicalName="AXE.PackagingTool.Schemas.EAD_media.xsd" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.3" Condition="'$(UseBundledDependencies)' != 'true'" />
    <PackageReference Include="ExcelDataReader" Version="3.8.0" Condition="'$(UseBundledDependencies)' != 'true'" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.8.0" Condition="'$(UseBundledDependencies)' != 'true'" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.9" Condition="'$(UseBundledDependencies)' != 'true'" />
    <Reference Include="lib\*.dll" Condition="'$(UseBundledDependencies)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <Page Remove="AXE.PackagingTool.App.xaml" />
    <ApplicationDefinition Include="AXE.PackagingTool.App.xaml" />
    <None Include="App.config" CopyToOutputDirectory="PreserveNewest" TargetPath="AXE.PackagingTool.dll.config" />
    <Content Include="Metadata\**;MauExcel\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
